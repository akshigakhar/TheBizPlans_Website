# Canonicalize every request in one hop: HTTPS and the apex hostname.
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^thebizplans\.com$ [NC]
RewriteRule ^ https://thebizplans.com%{REQUEST_URI} [L,R=301,NE]

# Consolidate legacy and duplicate page URLs onto their approved primary URLs.
RewriteRule ^ainp-business-plan\.html$ /aaip-entrepreneur-business-plan.html [L,R=301]
RewriteRule ^bc-pnp-business-plan\.html$ /bcpnp-business-plan.html [L,R=301]
Redirect 301 "/create sample-other-plan.html" /sample-other-plan.html
RewriteRule ^blog-key-elements-strong-business\.html$ /blog-key-elements-strong-business-plan.html [L,R=301]
RewriteRule ^create-sample-other-plan\.html$ /sample-other-plan.html [L,R=301]

<IfModule mod_headers.c>
    # HSTS applies to the apex only. Add includeSubDomains only after every
    # current and future subdomain is confirmed to support HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"

    # Inline code remains temporarily enabled for compatibility. Migrate it to
    # external files or nonces/hashes before removing the two unsafe-inline
    # allowances. frame-ancestors supplies clickjacking protection.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://api.web3forms.com; script-src 'self' 'unsafe-inline' https://ajax.googleapis.com https://cdn.jsdelivr.net https://code.jquery.com https://maps.googleapis.com https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://*.googleapis.com https://*.google.com https://*.google-analytics.com https://*.googletagmanager.com; frame-src https://www.google.com https://www.youtube.com https://player.vimeo.com https://view.vzaar.com; upgrade-insecure-requests"

    # HTML and server responses must revalidate rather than becoming stale.
    <FilesMatch "\.(?:html?|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Search engines need to fetch these files to render pages, but the files
    # themselves are not search results. Keep crawling enabled and prevent
    # standalone CSS/JavaScript URLs from being indexed.
    <FilesMatch "\.(?:css|js)$">
        Header always set X-Robots-Tag "noindex"
    </FilesMatch>

    # Hash-named assets may be cached permanently. Examples matched include
    # app.3f2a1c9e.js and styles-a8b7c6d5.css (8+ hex characters).
    <FilesMatch "(?:[.-][0-9a-fA-F]{8,})\.(?:css|js|gif|ico|jpe?g|png|svg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Prefer Brotli when available and retain gzip as the hosting fallback.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
